{
  "steps": [
    {
      "step": "ingest",
      "args": { "requestId": 1, "status": 200, "body": "{\"products\": [{\"id\": 1, \"title\": \"Product 1\", \"description\": \"A product\", \"category\": \"misc\", \"brand\": \"Acme\", \"price\": 9.99, \"discountPercentage\": 7.17, \"rating\": 4.2, \"stock\": 20, \"thumbnail\": \"https://cdn.dummyjson.com/1.png\", \"tags\": [\"misc\"]}, {\"id\": 2, \"title\": \"Product 2\", \"description\": \"A product\", \"category\": \"misc\", \"brand\": \"Acme\", \"price\": 0.05, \"discountPercentage\": 50.0, \"rating\": 4.2, \"stock\": 20, \"thumbnail\": \"https://cdn.dummyjson.com/2.png\", \"tags\": [\"misc\"]}, {\"id\": 3, \"title\": \"Product 3\", \"description\": \"A product\", \"category\": \"misc\", \"brand\": \"Acme\", \"price\": 100.0, \"discountPercentage\": 0.0, \"rating\": 4.2, \"stock\": 20, \"thumbnail\": \"https://cdn.dummyjson.com/3.png\", \"tags\": [\"misc\"]}], \"total\": 3, \"skip\": 0, \"limit\": 3}" },
      "expect": { "accepted": 3, "rejected": 0 }
