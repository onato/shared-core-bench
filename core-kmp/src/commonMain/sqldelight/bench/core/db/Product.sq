CREATE TABLE product (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    price REAL NOT NULL
);

upsert:
INSERT OR REPLACE INTO product (id, title, price) VALUES (?, ?, ?);

count:
SELECT count(*) FROM product;

byId:
SELECT id, title, price FROM product WHERE id = ?;

pageAfter:
SELECT id, title, price FROM product WHERE id > ? ORDER BY id LIMIT ?;
