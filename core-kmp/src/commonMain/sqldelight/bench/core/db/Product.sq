CREATE TABLE product (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    brand TEXT,
    price REAL NOT NULL,
    discount_percentage REAL NOT NULL,
    discounted_price REAL NOT NULL,
    rating REAL NOT NULL,
    stock INTEGER NOT NULL,
    thumbnail TEXT NOT NULL
);

CREATE TABLE product_tag (
    product_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (product_id, position)
);

upsert:
INSERT OR REPLACE INTO product (
    id, title, description, category, brand, price, discount_percentage, discounted_price, rating, stock, thumbnail
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTagsOf:
DELETE FROM product_tag WHERE product_id = ?;

insertTag:
INSERT INTO product_tag (product_id, position, tag) VALUES (?, ?, ?);

count:
SELECT count(*) FROM product;

byId:
SELECT id, title, description, category, brand, price, discount_percentage, rating, stock, thumbnail
FROM product WHERE id = ?;

tagsOf:
SELECT tag FROM product_tag WHERE product_id = ? ORDER BY position;

pageAfter:
SELECT id, title, price, discounted_price, rating, thumbnail FROM product
WHERE id > :cursor
  AND (instr(lower(title), lower(:text)) > 0 OR instr(lower(brand), lower(:text)) > 0)
  AND (:category IS NULL OR category = :category)
  AND (:minPrice IS NULL OR discounted_price >= :minPrice)
  AND (:maxPrice IS NULL OR discounted_price <= :maxPrice)
ORDER BY CASE :sort
    WHEN 'price-asc' THEN discounted_price
    WHEN 'price-desc' THEN -discounted_price
    WHEN 'rating-desc' THEN -rating
    ELSE id
  END, id
LIMIT :limit;
